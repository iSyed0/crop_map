# Port this API listens on. The frontend's default VITE_VEGETATION_API_URL
# assumes 4310 — change both together if you need a different port.
# (4000 is avoided here because it's already claimed by other software on
# some Windows machines, e.g. SonicWall NetExtender's nxd.exe.)
PORT=4310

# --- Earth Engine service-account credentials (pick ONE of the two) ---

# Option A: path to the downloaded service-account JSON key file.
# Put the actual key file in this folder (it's gitignored) and point here.
GEE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Option B: the full JSON key contents, inline, as a single line.
# Useful when deploying somewhere you can't easily ship a file (e.g. a
# platform env-var secret). Leave GEE_SERVICE_ACCOUNT_KEY_PATH unset if using this.
# GEE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
